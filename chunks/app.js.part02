><h3>Hammer</h3><h4>Cây Búa</h4><p>Lực bán đẩy giá xuống nhưng bên mua kéo giá trở lại trước khi nến đóng cửa.</p><button data-nav="/pattern/hammer">Xem mẫu hình ${arrow()}</button></div>
  </div></div></section>
  <section class="section" id="levels"><div class="section-heading"><div><span class="kicker">LEARNING PATH</span><h2>Học theo từng Level</h2></div><p>Đi từ cấu trúc nến đến mẫu hình, price action, volume và Wyckoff. Mỗi Level là một lớp ngôn ngữ của biểu đồ.</p></div><div class="levels-grid">${levels.map(levelCard).join('')}</div></section>
  <section class="section analyzer-banner"><div><span class="kicker">AI CHART ANALYZER</span><h2>Khách hàng gửi chart.<br>Bạn có nhận định để phản hồi.</h2><p>Upload ảnh chart, nhận cấu trúc phân tích theo checklist và tạo một bản ngắn gọn để gửi khách hàng kèm chữ ký tư vấn viên.</p><button class="primary" data-nav="/analyzer">Mở Chart Analyzer ${arrow()}</button></div>
  <div class="mini-analysis"><div class="mini-title"><span>HPG · DAILY</span><span class="status-pill demo">DEMO</span></div><div class="analysis-row"><span>Structure</span><b>Uptrend</b></div><div class="analysis-row"><span>Pattern</span><b>Ascending Triangle</b></div><div class="analysis-row"><span>Volume</span><b>Chưa xác nhận breakout</b></div><div class="analysis-conclusion">Cấu trúc tăng vẫn được giữ, nhưng cần breakout kèm thanh khoản cải thiện để tăng độ tin cậy.</div></div></section>`;
}
function levelCard(level){
  const count = level.priceAction ? priceActionPatterns.length : level.chartPatterns ? chartPatterns.length : level.volumePrinciples ? volumePrinciples.length : level.wyckoff ? wyckoffLessons.length : level.bars ? patterns.filter(p=>p.candles===level.bars).length : level.multi ? patterns.filter(p=>p.candles>=4).length : null;
  const available = level.status==='ready';
  return `<button class="level-card ${available?'':'muted'}" ${available?`data-nav="/level/${Number(level.n)}"`:''}><div class="level-num">LEVEL ${level.n}</div><div class="level-icon">${level.n==='01'?anatomyIcon():level.priceAction?priceActionIcon():level.chartPatterns?chartPatternIcon():level.volumePrinciples?volumeIcon():level.wyckoff?wyckoffIcon():miniCandles(Math.min(level.bars||4,5))}</div><h3>${level.title}</h3><h4>${level.vi}</h4><p>${count?`${count} mẫu hình`:level.desc}</p><div class="level-footer"><span>${available?'Khám phá':'Coming next'}</span>${available?arrow():''}</div></button>`;
}

function anatomyPage(){
  const concepts = [['Open','Giá mở cửa','Điểm bắt đầu của khoảng thời gian.'],['High','Giá cao nhất','Mức giá cao nhất bên mua từng đẩy tới.'],['Low','Giá thấp nhất','Mức giá thấp nhất bên bán từng ép xuống.'],['Close','Giá đóng cửa','Vị trí kết thúc — thường quan trọng nhất để đọc quyền kiểm soát.'],['Body','Thân nến','Khoảng cách giữa Open và Close.'],['Wick / Shadow','Bóng nến','Phần giá đã đi qua nhưng không giữ được tới lúc đóng cửa.']];
  return pageWrap(`${breadcrumb(['Level 01','Candlestick Anatomy'])}<div class="level-hero"><div><span class="kicker">LEVEL 01</span><h1>Candlestick Anatomy</h1><h2>Cấu trúc một cây nến</h2><p>Trước khi gọi tên bất kỳ mẫu hình nào, hãy đọc được câu chuyện nằm trong Open, High, Low và Close.</p></div>${candlestickAnatomy()}</div><div class="content-grid anatomy-cards">${concepts.map((x,i)=>`<article class="concept-card"><span>0${i+1}</span><h3>${x[0]}</h3><h4>${x[1]}</h4><p>${x[2]}</p></article>`).join('')}</div><div class="rule-box"><span>NGUYÊN TẮC CHARTLAB</span><h3>Một cây nến không chỉ là hình dạng.</h3><p>Hãy đọc nó như câu chuyện về nơi giá đã đi qua, nơi bị từ chối và bên nào giữ lợi thế khi nến đóng cửa.</p></div>`);
}
function levelPage(n){
  const level = levels[n-1];
  if (!level || level.status!=='ready') return notFoundPage();
  if(n===6) return priceActionPage(level);
  if(n===7) return chartPatternPage(level);
  if(n===8) return volumePage(level);
  if(n===9) return wyckoffPage(level);
  const list = n===5 ? patterns.filter(p=>p.candles>=4) : patterns.filter(p=>p.candles===n-1);
  return listingPage(list, level.title, level.vi, `LEVEL ${level.n}`);
}

function priceActionPage(level){
  const intro = `<section class="price-action-intro"><div><span class="kicker">LEVEL 06 · RAW PRICE</span><h1>Price Action</h1><h2>Đọc co hẹp, mở rộng, rejection và false breakout.</h2><p>Level này tách khỏi 61 TA-Lib candlestick patterns. Mỗi setup được định nghĩa bằng hành vi High–Low–Open–Close và luôn cần context + confirmation.</p></div><div class="pa-principles"><article><b>01</b><span>Compression</span><p>Inside Bar và coiling cho thấy volatility thu hẹp.</p></article><article><b>02</b><span>Expansion</span><p>Outside Bar cho thấy range mở rộng; Close mới giúp đọc bên thắng.</p></article><article><b>03</b><span>Rejection</span><p>Pin Bar/Tweezer thể hiện vùng giá bị từ chối.</p></article><article><b>04</b><span>Trap</span><p>False Breakout/Fakey cho thấy cú phá vỡ không được duy trì.</p></article></div></section>`;
  const groups = ['Compression','Expansion','Reversal Bar','Rejection','Trap','Combo','Repeated Rejection'];
  const filtered = filterPatterns(priceActionPatterns);
  return pageWrap(`${breadcrumb(['Level 06','Price Action'])}${intro}<div class="filters pa-filters"><label class="search">${searchIcon()}<input id="pattern-search" value="${escAttr(state.library.query)}" placeholder="Tìm Inside Bar, Pin Bar, Fakey..."></label><div class="filter-group" data-filter="bias">${['All','Bullish','Bearish','Neutral'].map(x=>`<button data-value="${x}" class="${state.library.bias===x?'selected':''}">${x==='All'?'Tất cả':x}</button>`).join('')}</div><div class="filter-group" data-filter="difficulty">${['All','Core','Intermediate','Advanced'].map(x=>`<button data-value="${x}" class="${state.library.difficulty===x?'selected':''}">${x==='All'?'Mọi cấp':x}</button>`).join('')}</div></div><div class="result-count">Hiển thị <b>${filtered.length}</b> / ${priceActionPatterns.length} setup</div>${patternGridOrEmpty(filtered)}<section class="pa-source-note"><span class="kicker">SOURCE BOUNDARY</span><h3>Price Action không có một “TA-Lib 61” tương đương.</h3><p>ChartLab giữ nguồn ngay trong từng trang chi tiết và phân biệt rule nội bộ với định nghĩa của nguồn. Không gộp 14 setup này vào số 61 mẫu nến đã audit.</p></section>`);
}

function chartPatternPage(level){
  const intro = `<section class="price-action-intro chart-pattern-intro"><div><span class="kicker">LEVEL 07 · MULTI-SWING STRUCTURE</span><h1>Classical Chart Patterns</h1><h2>Đọc sự chuyển dịch cung – cầu qua nhiều swing giá.</h2><p>Khác candlestick và Price Action ngắn hạn, mẫu hình giá hình thành qua nhiều phiên/swing. ChartLab chỉ gọi pattern “hoàn tất” khi điều kiện breakout/breakdown được xác nhận theo nguồn.</p></div><div class="pa-principles"><article><b>01</b><span>Reversal</span><p>Double/Triple Top-Bottom và Head & Shoulders cần prior trend + neckline break.</p></article><article><b>02</b><span>Compression</span><p>Triangles/Rectangle mô tả range co hẹp hoặc cân bằng trước resolution.</p></article><article><b>03</b><span>Continuation</span><p>Flag/Pennant cần flagpole rõ rồi pause ngắn trước continuation.</p></article><article><b>04</b><span>Shape + Break</span><p>Wedge, Cup và Rounding Bottom chỉ có giá trị khi cấu trúc và breakout cùng khớp.</p></article></div></section>`;
  const filtered = filterPatterns(chartPatterns);
  return pageWrap(`${breadcrumb(['Level 07','Chart Patterns'])}${intro}<div class="filters pa-filters"><label class="search">${searchIcon()}<input id="pattern-search" value="${escAttr(state.library.query)}" placeholder="Tìm Double Top, Head & Shoulders, Triangle..."></label><div class="filter-group" data-filter="bias">${['All','Bullish','Bearish','Neutral'].map(x=>`<button data-value="${x}" class="${state.library.bias===x?'selected':''}">${x==='All'?'Tất cả':x}</button>`).join('')}</div><div class="filter-group" data-filter="difficulty">${['All','Core','Intermediate','Advanced'].map(x=>`<button data-value="${x}" class="${state.library.difficulty===x?'selected':''}">${x==='All'?'Mọi cấp':x}</button>`).join('')}</div></div><div class="result-count">Hiển thị <b>${filtered.length}</b> / ${chartPatterns.length} mẫu hình giá</div>${patternGridOrEmpty(filtered,'chart-pattern-grid')}<section class="pa-source-note"><span class="kicker">CONFIRMATION FIRST</span><h3>Nhìn ra hình dạng chưa có nghĩa pattern đã hoàn tất.</h3><p>Double Top cần support break; Inverse H&S cần neckline breakout; Symmetrical Triangle cần chờ hướng phá vỡ. Đây là nguyên tắc bắt buộc của Chart Analyzer.</p></section>`);
}

function volumePage(level){
  const intro = `<section class="price-action-intro volume-intro"><div><span class="kicker">LEVEL 08 · PARTICIPATION & CONFIRMATION</span><h1>Price & Volume</h1><h2>Đọc mức độ tham gia phía sau chuyển động của giá.</h2><p>Volume không dự báo hướng một mình. ChartLab dùng volume để xác nhận hoặc đặt dấu hỏi cho trend, breakout và phản ứng giá — sau đó mới nối sang Effort vs Result của Wyckoff.</p></div><div class="pa-principles"><article><b>01</b><span>Participation</span><p>Volume cho biết mức độ thị trường tham gia vào chuyển động giá.</p></article><article><b>02</b><span>Confirmation</span><p>Trend/breakout đáng tin hơn khi participation đi cùng hướng với price.</p></article><article><b>03</b><span>Divergence</span><p>Giá tạo cực trị mới nhưng volume suy giảm là non-confirmation cần theo dõi.</p></article><article><b>04</b><span>Effort vs Result</span><p>Volume là effort; mức price progress/range là result.</p></article></div></section>`;
  const filtered = filterPatterns(volumePrinciples);
  return pageWrap(`${breadcrumb(['Level 08','Price & Volume'])}${intro}<div class="filters pa-filters"><label class="search">${searchIcon()}<input id="pattern-search" value="${escAttr(state.library.query)}" placeholder="Tìm Breakout Volume, Divergence, Effort vs Result..."></label><div class="filter-group" data-filter="bias">${['All','Bullish','Bearish','Neutral'].map(x=>`<button data-value="${x}" class="${state.library.bias===x?'selected':''}">${x==='All'?'Tất cả':x}</button>`).join('')}</div><div class="filter-group" data-filter="difficulty">${['All','Core','Intermediate','Advanced'].map(x=>`<button data-value="${x}" class="${state.library.difficulty===x?'selected':''}">${x==='All'?'Mọi cấp':x}</button>`).join('')}</div></div><div class="result-count">Hiển thị <b>${filtered.length}</b> / ${volumePrinciples.length} nguyên tắc</div>${patternGridOrEmpty(filtered,'volume-grid')}<section class="pa-source-note"><span class="kicker">VOLUME IS CONTEXT</span><h3>Volume lớn không tự động bullish hay bearish.</h3><p>Cùng một volume spike có thể là breakout confirmation, absorption hoặc climax. ChartLab luôn đọc volume cùng direction, spread/range, vị trí đóng cửa và phản ứng sau đó.</p></section>`);
}


function wyckoffPage(level){
  const intro = `<section class="price-action-intro wyckoff-intro"><div><span class="kicker">LEVEL 09 · PRICE + VOLUME + TRADING RANGE</span><h1>Wyckoff Method</h1><h2>Đọc quá trình chuyển giao quyền kiểm soát giữa Supply và Demand.</h2><p>ChartLab dạy Wyckoff theo thứ tự: Laws → Schematics → Phases → Events. AI chỉ được gọi tên phase/event khi chart có đủ prior trend, trading range và volume context.</p></div><div class="pa-principles"><article><b>01</b><span>3 Laws</span><p>Supply & Demand · Cause & Effect · Effort vs Result.</p></article><article><b>02</b><span>Trading Range</span><p>Accumulation, Distribution và continuation ranges.</p></article><article><b>03</b><span>Phase A–E</span><p>Từ stopping action đến trend departure.</p></article><article><b>04</b><span>Events</span><p>SC, Spring, SOS, UTAD, SOW, LPS/LPSY...</p></article></div></section>`;
  const groups=[...new Set(wyckoffLessons.map(x=>x.group))];
  const filtered=filterPatterns(wyckoffLessons);
  return pageWrap(`${breadcrumb(['Level 09','Wyckoff'])}${intro}<div class="filters pa-filters"><label class="search">${searchIcon()}<input id="pattern-search" value="${escAttr(state.library.query)}" placeholder="Tìm Spring, UTAD, Phase C, SOS..."></label><div class="filter-group" data-filter="bias">${['All','Bullish','Bearish','Neutral'].map(x=>`<button data-value="${x}" class="${state.library.bias===x?'selected':''}">${x==='All'?'Tất cả':x}</button>`).join('')}</div><div class="filter-group" data-filter="difficulty">${['All','Core','Intermediate','Advanced'].map(x=>`<button data-value="${x}" class="${state.library.difficulty===x?'selected':''}">${x==='All'?'Mọi cấp':x}</button>`).join('')}</div></div><div class="wyckoff-group-nav">${groups.map(g=>`<span>${esc(g)} · ${wyckoffLessons.filter(x=>x.group===g).length}</span>`).join('')}</div><div class="result-count">Hiển thị <b>${filtered.length}</b> / ${wyckoffLessons.length} bài Wyckoff</div>${patternGridOrEmpty(filtered,'wyckoff-grid')}<section class="pa-source-note"><span class="kicker">SCHEMATIC ≠ TEMPLATE</span><h3>Không ép mọi vùng sideway thành Accumulation hoặc Distribution.</h3><p>Spring và UTAD là optional events. Nếu thiếu prior trend, Trading Range hoặc volume, Chart Analyzer phải hạ confidence hoặc trả “không đủ dữ liệu”.</p></section>`);
}
