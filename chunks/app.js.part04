escText(b)}</p></div>`;}
function detailSection(num,title,body){return `<section class="detail-section"><div class="section-num">${num}</div><div><h3>${title}</h3>${body}</div></section>`;}
function fact(label,value,good=false){return `<div class="fact"><span>${label}</span><b class="${good?'good':''}">${good?'✓ ':''}${value}</b></div>`;}

function analyzerPage(){
  const a=state.analyzer, live=Boolean(API_ENDPOINT), recent=[...state.history].sort((x,y)=>(Number(y.pinned)-Number(x.pinned))||((y.updatedAt||y.createdAt)-(x.updatedAt||x.createdAt))).slice(0,3);
  const modeLabel=live?'AI LIVE READY':'DEMO MODE';
  const modeText=live
    ?'Frontend đã có endpoint AI. Khi bấm phân tích, ảnh được nén trên trình duyệt rồi gửi tới backend serverless để đọc chart.'
    :'Chưa cấu hình AI endpoint. Ảnh chỉ preview trên máy và nút phân tích sẽ chạy kết quả demo có gắn nhãn rõ ràng.';
  return pageWrap(`<div class="analyzer-head"><div><span class="kicker">AI CHART ANALYZER</span><h1>Chụp chart. Đọc cấu trúc.<br>Tạo bản gửi khách hàng.</h1><p>${live?'Analyzer đã sẵn sàng gọi AI qua backend serverless.':'Bản frontend vẫn chạy độc lập trên GitHub Pages; khi dán Worker URL vào config.js, Analyzer tự chuyển sang AI live.'}</p></div><div class="analyzer-head-actions"><button class="settings" data-nav="/history">◷ Lịch sử${state.history.length?` · ${state.history.length}`:''}</button><button class="settings" id="signature-settings">⚙ Chữ ký</button></div></div>
  <div class="demo-notice ${live?'live-notice':''}"><span>${modeLabel}</span><p>${modeText}</p></div>
  ${a.historyId?`<div class="history-context"><span>ĐANG MỞ TỪ LỊCH SỬ</span><p>Kết quả hiện tại đã được lưu trên thiết bị. Nếu chỉnh sửa bản gửi khách hàng, ChartLab sẽ cập nhật cùng mục này.</p><button data-nav="/history">Xem lịch sử →</button></div>`:''}
  ${a.error?`<div class="analysis-error"><b>Không phân tích được chart.</b><span>${escText(a.error)}</span></div>`:''}
  <div class="analyzer-workspace"><section class="upload-panel"><div class="panel-label">01 · CHART INPUT</div><label class="dropzone ${a.preview?'has-image':''}">${a.preview?`<img src="${a.preview}" alt="Chart preview">`:`${cameraIcon(true)}<h3>Kéo hoặc chọn ảnh chart</h3><p>PNG · JPG · WEBP</p>`}<input id="chart-file" type="file" accept="image/png,image/jpeg,image/webp"></label><div class="input-row"><label><span>Mã cổ phiếu</span><input id="chart-symbol" value="${escAttr(a.symbol)}" placeholder="HPG"></label><label><span>Khung thời gian</span><select id="chart-timeframe">${['Daily','Weekly','4H','1H','15m'].map(x=>`<option ${a.timeframe===x?'selected':''}>${x}</option>`).join('')}</select></label></div><div class="chart-photo-tips"><span>ẢNH TỐT NHẤT KHI</span><div><b>✓ Thấy đủ nến</b><b>✓ Có trục giá</b><b>✓ Có volume nếu muốn phân tích volume</b><b>✓ Không crop quá sát</b></div></div><button class="primary full" id="analyze-button" ${!a.file||a.loading?'disabled':''}>${a.loading?'Đang đọc chart…':`Phân tích chart ${arrow()}`}</button>${recent.length?`<div class="recent-analysis"><div class="recent-head"><span>PHÂN TÍCH GẦN ĐÂY</span><button data-nav="/history">Xem tất cả →</button></div>${recent.map(x=>`<button class="recent-row" data-history-open="${escAttr(x.id)}"><b>${escText(x.symbol)}</b><span>${escText(x.timeframe)}</span><small>${formatHistoryDate(x.updatedAt||x.createdAt)}</small></button>`).join('')}</div>`:''}</section>
  <section class="results-panel"><div class="results-top"><div class="panel-label">02 · OUTPUT</div>${a.result?`<span class="demo-chip ${a.result.source==='live'?'live-chip':''}">${a.result.source==='live'?'AI RESULT':'DEMO RESULT'}</span>`:''}</div>${a.result?analyzerResultMarkup():emptyAnalysis(a.loading)}</section></div>`,'wide');
}
function emptyAnalysis(loading=false){return `<div class="empty-analysis"><div class="scan-icon ${loading?'scanning':''}"><span></span><span></span><span></span></div><h3>${loading?'AI đang đọc screenshot…':'Chưa có chart để phân tích'}</h3><p>${loading?'Hệ thống đang chạy quality gate trước, sau đó mới đọc cấu trúc giá, pattern, volume và Wyckoff.':'Upload ảnh bên trái, điền mã cổ phiếu nếu có và bấm “Phân tích chart”.'}</p><div class="empty-checklist">${['Market Structure','Key Levels','Candlestick','Price Action','Chart Pattern','Volume','Wyckoff'].map(x=>`<div><i></i>${x}</div>`).join('')}</div></div>`;}
function analyzerResultMarkup(){
  const a=state.analyzer, r=a.result;
  return `<div class="tabs"><button data-tab="analysis" class="${a.tab==='analysis'?'active':''}">Phân tích chi tiết</button><button data-tab="client" class="${a.tab==='client'?'active':''}">Bản gửi khách hàng</button></div>${a.tab==='analysis'?analysisResult(r):clientResult(r)}`;
}
function analysisResult(r){
  const q=r.imageQuality||{}, status=r.analysisStatus||{}, adv=r.advisorView||{};
  const visible=[['Candlesticks',q.candlesticks],['Price axis',q.priceAxis],['Volume',q.volume],['Indicators',q.indicators],['Đủ lịch sử',q.enoughHistory]];
  const statusClass=String(status.status||'Limited').toLowerCase();
  return `<div class="analysis-output">
    <div class="quality-gate ${statusClass}"><div><span>QUALITY GATE · ${escText(status.status||'Limited')}</span><h3>${escText(status.message||'Ảnh có thể phân tích một phần.')}</h3></div>${status.missing?.length?`<div class="quality-missing">${status.missing.map(x=>`<b>${escText(x)}</b>`).join('')}</div>`:''}</div>
    <div class="advisor-snapshot ${biasClass(adv.bias)}"><div class="advisor-top"><div><span>ADVISOR SNAPSHOT</span><h2>${escText(adv.headline||'Chưa đủ dữ liệu')}</h2></div><div class="advisor-bias"><b>${biasLabel(adv.bias)}</b>${confidenceChip(adv.confidence)}</div></div><div class="advisor-grid"><article><span>THEO DÕI</span><p>${escText(adv.watch||'—')}</p></article><article><span>XÁC NHẬN KHI</span><p>${escText(adv.confirmation||'—')}</p></article><article><span>SUY YẾU KHI</span><p>${escText(adv.invalidation||'—')}</p></article></div></div>
    <div class="visibility"><span>NHỮNG GÌ HỆ THỐNG NHÌN THẤY · ${escText(q.grade||'N/A')}</span><div>${visible.map(([name,yes])=>`<b class="${yes?'':'muted'}">${yes?'✓':'?'} ${name}</b>`).join('')}</div>${q.note?`<p>${escText(q.note)}</p>`:''}</div>
    ${r.sections.map((s,i)=>`<div class="analysis-block"><span>0${i+1}</span><div><div class="analysis-label"><small>${s.title}</small>${confidenceChip(s.confidence)}</div><h3>${escText(s.value)}</h3><p>${escText(s.note)}</p>${s.link?`<button data-nav="${s.link}">Xem bài học ${arrow()}</button>`:''}</div></div>`).join('')}
    ${r.warnings?.length?`<div class="analysis-warnings"><span>LƯU Ý TỪ ẢNH</span>${r.warnings.map(w=>`<p>• ${escText(w)}</p>`).join('')}</div>`:''}
    <div class="final-view"><span>KẾT LUẬN</span><p>${escText(r.conclusion)}</p></div>
  </div>`;
}
function confidenceChip(value='Insufficient'){
  const cls=String(value).toLowerCase().replace(/\s+/g,'-');
  return `<span class="confidence ${cls}">${escText(value)}</span>`;
}
function biasLabel(value='Insufficient'){return ({Positive:'Tích cực',Neutral:'Trung tính',Cautious:'Thận trọng',Insufficient:'Không đủ dữ liệu'})[value]||'Không đủ dữ liệu';}
function biasClass(value='Insufficient'){return `bias-${String(value||'Insufficient').toLowerCase()}`;}
function clientResult(r){
  const a=state.analyzer,p=state.profile, blocked=r.analysisStatus?.status==='NeedsBetterImage';
  const selectedText=a.clientMode==='short'?a.clientShort:a.clientText;
  return `<div class="client-card" id="client-export-card"><div class="client-title"><span>${escText(r.symbol)} · ${escText(r.timeframe.toUpperCase())}</span><h2>Góc nhìn kỹ thuật</h2></div>
  <div class="client-mode"><button data-client-mode="short" class="${a.clientMode==='short'?'active':''}">Bản ngắn</button><button data-client-mode="full" class="${a.clientMode==='full'?'active':''}">Bản chi tiết</button></div>
  ${blocked?`<div class="client-blocked"><b>Ảnh cần chụp lại trước khi gửi nhận định.</b><span>${escText(r.analysisStatus?.message||'Ảnh chưa đủ rõ.')}</span></div>`:''}
  ${a.editing?`<textarea id="client-text" rows="10">${escText(selectedText)}</textarea>`:`<p class="client-text">${escText(selectedText)}</p>`}
  ${p.enabled&&p.name?`<div class="signature-preview"><b>${escText(p.name)}</b><span>${escText(p.title)}${p.unit?` | ${escText(p.unit)}`:''}</span>${p.contact?`<small>${escText(p.contact)}</small>`:''}</div>`:''}
  <div class="client-actions"><button class="secondary" id="edit-client">${a.editing?'✓ Hoàn tất':'✎ Chỉnh sửa'}</button><button class="secondary" id="save-history">${a.historyId?'✓ Đã lưu':'♡ Lưu lịch sử'}</button><button class="secondary" id="export-client" ${blocked?'disabled':''}>▣ Xuất ảnh</button><button class="secondary" id="share-client" ${blocked?'disabled':''}>↗ Chia sẻ</button><button class="primary" id="copy-client">${blocked?'Copy yêu cầu chụp lại':'Copy gửi khách hàng'}</button></div><small class="export-note">Bản ngắn phù hợp Zalo/Chat; bản chi tiết phù hợp khi cần thêm context. Kết quả được lưu cục bộ trên thiết bị, không cần tài khoản.</small><small class="disclaimer">Phân tích kỹ thuật mang tính tham khảo dựa trên dữ liệu hiển thị trên biểu đồ và không phải khuyến nghị mua/bán.</small></div>`;
}
function demoResult(symbol,timeframe){return {source:'demo',symbol,timeframe,analysisStatus:{status:'Limited',message:'Demo mode không đọc nội dung screenshot; kết quả bên dưới chỉ minh hoạ giao diện.',missing:['AI live chưa được cấu hình']},imageQuality:{grade:'Usable',note:'Demo mode không đánh giá chất lượng ảnh thật.',candlesticks:true,priceAxis:true,volume:true,indicators:false,enoughHistory:true},advisorView:{bias:'Neutral',confidence:'Low',headline:'Ví dụ giao diện nhận định kỹ thuật',watch:'Theo dõi vùng đỉnh gần nhất.',confirmation:'Breakout kèm thanh khoản cải thiện.',invalidation:'Mất cấu trúc đáy gần nhất.'},sections:[{title:'MARKET STRUCTURE',value:'Uptrend ngắn hạn',note:'Cấu trúc demo mô phỏng chuỗi Higher High – Higher Low. Đây chưa phải kết quả đọc từ ảnh thật.',confidence:'Low'},{title:'KEY LEVELS',value:'Theo dõi đỉnh gần nhất',note:'Khi nối AI thật, hệ thống sẽ đọc vùng hỗ trợ/kháng cự từ chính screenshot.',confidence:'Low'},{title:'CANDLESTICK',value:'Possible Hammer',note:'Ví dụ minh hoạ cho workflow phát hiện pattern và confidence.',confidence:'Low',link:'/pattern/hammer'},{title:'PRICE ACTION',value:'Possible Inside Bar',note:'Demo cách Analyzer liên kết setup Price Action về bài học tương ứng.',confidence:'Low',link:'/pattern/insidebar'},{title:'CHART PATTERN',value:'Possible Ascending Triangle',note:'Demo cách Analyzer link mẫu hình giá cổ điển về Level 07; AI live chỉ gắn nhãn khi đủ swing structure và breakout context.',confidence:'Low',link:'/pattern/ascendingtriangle'},{title:'VOLUME',value:'Breakout volume chưa xác nhận',note:'Demo cách Analyzer liên kết Price & Volume về Level 08; AI live chỉ đọc volume khi panel đủ rõ.',confidence:'Low',link:'/pattern/breakoutvolumeexpansion'},{title:'WYCKOFF',value:'Possible Accumulation',note:'Demo cách Analyzer liên kết Wyckoff về Level 09; AI live chỉ gắn phase/event khi đủ prior trend + trading range + price-volume context.',confidence:'Low',link:'/pattern/accumulation'}],conclusion:'Cấu tr