  wyckoffutad: [{id:'wyckoffspring',note:'Hai events đối xứng ở hai biên Trading Range.'},{id:'wyckoffsos',note:'UTAD thất bại trên resistance; SOS là demand expansion phá resistance thành công.'}],
  wyckoffsos: [{id:'wyckoffsow',note:'SOS là strength rời range lên; SOW là weakness rời range xuống.'},{id:'wyckofflps',note:'LPS thường là pullback sau SOS với supply yếu hơn.'}],
  wyckoffsow: [{id:'wyckoffsos',note:'Một event strength, một event weakness.'},{id:'wyckofflpsy',note:'LPSY thường là rally/retest yếu sau SOW.'}],
  wyckofflps: [{id:'wyckofflpsy',note:'LPS là support test trong bullish structure; LPSY là supply test trong bearish structure.'},{id:'wyckoffsos',note:'SOS là impulse strength; LPS là pullback sau đó.'}],
  wyckofflpsy: [{id:'wyckofflps',note:'Hai events đối xứng trong accumulation/distribution.'},{id:'wyckoffsow',note:'SOW là break weakness; LPSY là weak rally sau đó.'}],
