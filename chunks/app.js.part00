  wyckoffaccumulation: [{id:'wyckoffdistribution',note:'Cùng là Trading Range nhưng accumulation hấp thụ supply sau decline; distribution hấp thụ demand sau advance.'},{id:'wyckoffreaccumulation',note:'Re-accumulation xảy ra trong một uptrend lớn; accumulation điển hình hình thành sau downtrend.'}],
  wyckoffdistribution: [{id:'wyckoffaccumulation',note:'Distribution xuất hiện sau advance; accumulation sau decline.'},{id:'wyckoffredistribution',note:'Re-distribution là pause trong downtrend; distribution điển hình sau uptrend.'}],
  wyckoffreaccumulation: [{id:'wyckoffredistribution',note:'Một mẫu nghiêng về continuation uptrend, mẫu kia continuation downtrend.'},{id:'wyckoffaccumulation',note:'Điểm phân biệt cốt lõi là prior trend trước Trading Range.'}],
