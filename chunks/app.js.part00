  wyckoffbc: [{id:'wyckoffsc',note:'BC là climax mua phía trên; SC là climax bán phía dưới.'},{id:'volumeclimax',note:'BC cần sequence/context Wyckoff chứ không chỉ một volume spike.'}],
  wyckoffps: [{id:'wyckoffpsy',note:'PS là Preliminary Support sau decline; PSY là Preliminary Supply sau advance.'}],
  wyckoffpsy: [{id:'wyckoffps',note:'Hai preliminary events đối xứng theo prior trend.'}],
  wyckoffaccphasec: [{id:'wyckoffdistphasec',note:'Accumulation Phase C có thể Spring/Test; Distribution Phase C có thể UT/UTAD.'}],
  wyckoffdistphasec: [{id:'wyckoffaccphasec',note:'Hai Phase C kiểm tra supply/demand ở hai phía đối lập của Trading Range.'}]
};

let state = { route:'/', hover:null, search:'', bias:'All', difficulty:'All', group:'All', upload:null, compressedUpload:null, symbol:'', timeframe:'Daily', analysis:null, analysisTab:'analysis', clientMode:'short', editing:false, editedClientText:'', settingsOpen:false, selectedCompare:null, currentHistoryId:null, loadedFromHistory:false, historyItems:loadHistoryItems(), historyShowPinned:false };

function normalizeBias(b){ const s=String(b||'').toLowerCase(); if(s.includes('bull')) return 'Bullish'; if(s.includes('bear')) return 'Bearish'; if(s==='both') return 'Both'; return 'Neutral'; }
function countFor(l){ if(l.n==='01') return 4; if(l.priceAction) return priceActionPatterns.length; if(l.chartPatterns) return chartPatterns.length; if(l.volumePrinciples) return volumePrinciples.length; if(l.wyckoff) return wyckoffLessons.length; return patterns.filter(p=>l.multi?p.candles>=4:p.candles===l.bars).length; }
function levelPatterns(l){ if(l.priceAction) return priceActionPatterns; if(l.chartPatterns) return chartPatterns; if(l.volumePrinciples) return volumePrinciples; if(l.wyckoff) return wyckoffLessons; if(l.multi) return patterns.filter(p=>p.candles>=4); return patterns.filter(p=>p.candles===l.bars); }
function getLearningItem(id){ return allLearningPatterns.find(p=>p.id===id); }
function getHistoryItems(){ return state.historyItems||[]; }
function loadHistoryItems(){
  try{ const x=JSON.parse(localStorage.getItem(HISTORY_META_KEY)||'[]'); return Array.isArray(x)?x.slice(0,HISTORY_MAX):[]; }catch{return [];}
}
function saveHistoryItems(items){ state.historyItems=items.slice(0,HISTORY_MAX); try{localStorage.setItem(HISTORY_META_KEY,JSON.stringify(state.historyItems));}catch{} }
function historyDB(){
  return new Promise((resolve,reject)=>{ if(!window.indexedDB) return resolve(null); const req=indexedDB.open('chartlab_history_db',1); req.onupgradeneeded=()=>{const db=req.result;if(!db.objectStoreNames.contains('images')) db.createObjectStore('images');}; req.onsuccess=()=>resolve(req.result); req.onerror=()=>reject(req.error); });
}
async function putHistoryImage(id,dataUrl){try{const db=await historyDB();if(!db)return;const tx=db.transaction('images','readwrite');tx.objectStore('images').put(dataUrl,id);}catch{}}
async function getHistoryImage(id){try{const db=await historyDB();if(!db)return '';return await new Promise(resolve=>{const tx=db.transaction('images','readonly');const r=tx.objectStore('images').get(id);r.onsuccess=()=>resolve(r.result||'');r.onerror=()=>resolve('');});}catch{return '';}}
async function deleteHistoryImage(id){try{const db=await historyDB();if(!db)return;db.transaction('images','readwrite').objectStore('images').delete(id);}catch{}}
function makeThumb(dataUrl,maxW=460,maxH=260,quality=.72){ return resizeDataUrl(dataUrl,maxW,maxH,quality); }
function safeSnapshotAnalysis(a){ if(!a) return null; try{return JSON.parse(JSON.stringify(a));}catch{return null;} }
function historySource(a){return a?._source==='live'?'AI Live':'Demo';}
function biasFromAnalysis(a){return a?.advisorSnapshot?.bias||'Không đủ dữ liệu';}
function historySummary(a){return a?.advisorSnapshot?.summary||a?.conclusion||'Chưa có tóm tắt.';}
async function persistCurrentAnalysis(){
  const a=state.analysis;if(!a||!state.upload)return;
  const now=Date.now(); const id=state.currentHistoryId||`ana_${now}_${Math.random().toString(36).slice(2,7)}`;
  let thumb=''; try{thumb=await makeThumb(state.upload,460,260,.72);}catch{}
  const existing=getHistoryItems().find(x=>x.id===id);
  const item={id,createdAt:existing?.createdAt||now,updatedAt:now,symbol:state.symbol||'—',timeframe:state.timeframe||'Daily',source:historySource(a),pinned:!!existing?.pinned,bias:biasFromAnalysis(a),quality:a?.qualityGate?.status||'Limited',summary:historySummary(a),thumbnail:thumb||existing?.thumbnail||'',analysis:safeSnapshotAnalysis(a),clientShort:String(a?.clientSummaryShort||''),clientDetailed:String(a?.clientSummaryDetailed||'')};
  let items=getHistoryItems().filter(x=>x.id!==id);items.unshift(item);
  if(items.length>HISTORY_MAX){ const pinned=items.filter(x=>x.pinned),others=items.filter(x=>!x.pinned); items=[...pinned,...others].sort((x,y)=>y.updatedAt-x.updatedAt).slice(0,HISTORY_MAX); }
  saveHistoryItems(items); state.currentHistoryId=id; state.loadedFromHistory=false;
  await putHistoryImage(id,state.compressedUpload||state.upload);
}
